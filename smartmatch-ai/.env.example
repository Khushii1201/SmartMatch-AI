# SmartMatch AI Configuration
# Backend Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database
DATABASE_PATH=database/smartmatch.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend API Base URL (defaults to /api through Vite proxy)
VITE_API_BASE_URL=/api
